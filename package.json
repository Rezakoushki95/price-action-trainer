{
  "name": "brooks-trainer",
  "version": "1.0.0",
  "description": "Mobile trainer for Al Brooks price action: one real ES session revealed one bar at a time, scored on process, not outcome.",
  "author": "Reza Koushki (https://github.com/Rezakoushki95)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rezakoushki95/brooks-trainer.git"
  },
  "homepage": "https://github.com/Rezakoushki95/brooks-trainer#readme",
  "private": true,
  "engines": {
    "node": ">=20.19.4"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "data": "node scripts/fetch-sessions.mjs",
    "web:build": "expo export --platform web --output-dir dist-web --clear",
    "web:serve": "node scripts/serve-web.mjs",
    "shoot": "node scripts/shoot.mjs",
    "preweb": "node scripts/copy-canvaskit.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.25",
    "expo-haptics": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~57.0.11",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "puppeteer-core": "^24.43.1",
    "react-dom": "19.2.3",
    "react-native-web": "^0.21.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
